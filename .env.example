# Environment Configuration for IHearVoices App
# Copy this file to .env and set your actual values

# Paystack Configuration
# The secret key is a Supabase Edge Function secret and must never use an
# EXPO_PUBLIC_ prefix. This flag only controls the app's test-mode labels.
EXPO_PUBLIC_PAYSTACK_TEST_MODE=true

# Voice Recognition Configuration
# The app now uses FREE Web Speech API (no API key required!)
# OpenAI is OPTIONAL - only uncomment if you want premium voice features
# EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Supabase Configuration (if not already set)
# EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
